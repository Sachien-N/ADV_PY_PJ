# Application A - Smart Expense & Budget Manager
# Copy to .env and fill real values. NEVER commit the .env file.

# --- Database ---
# Local development (SQLite):
DATABASE_URL=sqlite:///./expense_manager.db
# Production (Neon PostgreSQL, pooled connection string):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- API security ---
# Bearer token protecting write endpoints. Generate e.g. with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me

# --- Peer application integration (public HTTPS URLs after deployment) ---
SUBSCRIPTION_API_URL=https://shravan-subscriptions.onrender.com
SUBSCRIPTION_API_TOKEN=share-securely-with-shravan
ELECTRICITY_API_URL=https://hariharan-electricity.onrender.com
ELECTRICITY_API_TOKEN=share-securely-with-hariharan

# --- HTTP client tuning ---
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3

# --- CORS (production frontend origins, comma separated) ---
CORS_ORIGINS=http://localhost:8501,https://sachien-expense.streamlit.app

LOG_LEVEL=INFO

# Frontend (Streamlit) reads these when running app.py locally:
EXPENSE_API_URL=http://localhost:8001
EXPENSE_API_TOKEN=change-me

# Tests / local-only convenience (NEVER set in production):
# ALLOW_UNAUTHENTICATED_WRITES=1
